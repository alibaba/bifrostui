{
  "name": "@bifrostui/utils",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/bui-utils/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node esbuild.config.js",
        "cwd": "packages/bui-utils"
      },
      "outputs": ["{projectRoot}/dist", "{projectRoot}/es"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --project bui-utils",
        "cwd": "{workspaceRoot}"
      },
      "outputs": ["{workspaceRoot}/coverage"]
    }
  }
}
