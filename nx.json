{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "tui": {
    "enabled": false
  },
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": [
          "build",
          "test",
          "lint",
          "lint:js",
          "lint:style"
        ]
      }
    }
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist", "{projectRoot}/es"]
    },
    "test": {
      "inputs": [
        "{projectRoot}/src/**/*.{ts,tsx}",
        "!{projectRoot}/src/**/*.md",
        "{workspaceRoot}/vitest.config.mjs",
        "{workspaceRoot}/tests/**/*",
        "sharedGlobals"
      ],
      "outputs": ["{workspaceRoot}/coverage"]
    },
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc*",
        "{workspaceRoot}/.stylelintrc*"
      ]
    },
    "lint:js": {
      "inputs": ["default", "{workspaceRoot}/.eslintrc*"]
    },
    "lint:style": {
      "inputs": ["default", "{workspaceRoot}/.stylelintrc*"]
    }
  },
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals",
      "!{projectRoot}/**/*.md"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/**/*.spec.tsx",
      "!{projectRoot}/**/*.test.tsx",
      "!{projectRoot}/**/__tests__/**/*",
      "!{projectRoot}/**/__mocks__/**/*",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/tsconfig.*.json",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/pnpm-lock.yaml",
      "{workspaceRoot}/.gitignore"
    ]
  },
  "defaultProject": "@bifrostui/react",
  "useDaemonProcess": true
}
