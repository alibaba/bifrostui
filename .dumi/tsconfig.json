{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "paths": {
      "@@/*": [".dumi/tmp/*"],
      "dumi": [".dumi/tmp/dumi/exports.ts"],
      "dumi/theme/slots/*": [".dumi/theme/slots/*"],
      "@/*": ["node_modules/dumi/dist/*"],
      "@bifrostui/react": ["packages/bui-core/src/index.ts"],
      "@bifrostui/react/*": ["packages/bui-core/src/*"],
      "@bifrostui/icons": ["packages/bui-icons/src/index.ts"],
      "@bifrostui/types": ["packages/bui-types/src/index.ts"],
      "@bifrostui/utils": ["packages/bui-utils/src/index.ts"]
    },
    "jsx": "react",
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "**/*",
    "../.dumi/tmp/**/*",
    "../packages/**/*"
  ],
  "exclude": ["node_modules", "tmp/node_modules"]
}
