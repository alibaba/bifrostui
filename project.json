{
  "name": "@bifrostui/monorepo",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "sourceRoot": ".",
  "projectType": "library",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/test-cached.sh"
      }
    },
    "test:watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest"
      }
    },
    "test:run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run"
      }
    },
    "ci:test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --coverage"
      }
    }
  }
}
